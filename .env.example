# Database
DATABASE_MODE=postgre
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/loden?schema=public
# 容器启动时自动应用 prisma/migrations。设为 false 则跳过，改由外部 migrate deploy
DATABASE_AUTO_MIGRATE=true
# 用于 CREATE DATABASE 的管理连接；缺省把 DATABASE_URL 的库名改为 postgres
# DATABASE_BOOTSTRAP_URL=postgresql://postgres:your_password@localhost:5432/postgres
# URL 未带 schema 参数时使用，默认 public
# DATABASE_SCHEMA=public

# Runtime
NODE_ENV=production
PORT=7061
NUXT_RESOURCE=/app/resources

# Auth (required)
NUXT_AUTH_BASE_URL=http://localhost:7061/api/auth
NUXT_AUTH_SECRET=change-me
NUXT_SALT=change-me
NUXT_TOKEN_SECRET=

# Site
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_API_BASE=/
NUXT_PUBLIC_VERSION=

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
